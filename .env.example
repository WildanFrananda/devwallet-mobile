# Backend API base URL (NestJS server with /api/v1 prefix)
# iOS simulator: http://localhost:3000/api/v1
# Android emulator: http://10.0.2.2:3000/api/v1
API_BASE_URL=http://localhost:3000/api/v1
WS_BASE_URL=ws://localhost:3000/ws
FAUCET_WS_URL=ws://localhost:3000/faucet/ws

# Default chain when wallet first opens
DEFAULT_CHAIN=evm:sepolia

# Sentry / analytics — fill in Phase 2+
SENTRY_DSN=
ANALYTICS_KEY=

# Build provenance — populated by CI via:
#   GIT_COMMIT=$(git rev-parse --short HEAD)
# Falls back to "dev" in Settings → About if unset.
GIT_COMMIT=
