# Copy to e2e/secrets.env (gitignored) and fill in. Used ONLY by the Detox
# send spec (e2e/send.spec.ts) — never baked into the app binary.
#
#   cp e2e/secrets.env.example e2e/secrets.env
#
# A dedicated TESTNET wallet, funded with a little Sepolia ETH. Never put a
# mainnet seed here.

# 12/24-word mnemonic of the funded Sepolia test wallet.
E2E_SEND_MNEMONIC=

# Recipient for the 0.001 ETH test send. Defaults to a burn address if unset.
E2E_SEND_TO=0x000000000000000000000000000000000000dEaD
